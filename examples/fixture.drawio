<?xml version="1.0" encoding="UTF-8"?>
<!-- Test fixture: one circuit edge whose label is a CHILD VERTEX of the edge,
     which is how the real drawing encodes circuit ids. Tagging must wrap the
     parent edge, not the label, or extraction finds no hops. -->
<mxfile host="test" pages="1">
  <diagram name="fixture" id="f1">
    <mxGraphModel><root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="n1" value="star-cr6" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
        <mxGeometry x="40" y="40" width="120" height="60" as="geometry"/>
      </mxCell>
      <mxCell id="n2" value="chic-cr6" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
        <mxGeometry x="360" y="40" width="120" height="60" as="geometry"/>
      </mxCell>
      <mxCell id="e1" value="" style="strokeWidth=20;strokeColor=#3399FF;endArrow=none;"
              edge="1" parent="1" source="n1" target="n2">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="lbl1" value="WC30   400G" style="edgeLabel;fontSize=12;" vertex="1" parent="e1">
        <mxGeometry x="0.5" relative="1" as="geometry"/>
      </mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
